# Plantilla para desarrollo contra EMULADORES locales. Sin secretos: todo es ficticio.
# Uso: copiar a `.env.emulator` y arrancar la web con `pnpm dev:emulator` (vite --mode emulator).
# Este archivo NO sirve para builds de producción (la web lanzaría un error en el arranque).
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-tfg-vr
VITE_FIREBASE_STORAGE_BUCKET=demo-tfg-vr.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app-id

# Solo los usa scripts/seed-emulator.mjs (vía `node --env-file`). No llevan prefijo VITE_, no llegan al navegador.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=demo-tfg-vr
