rules_version = '2';

// ============================================================================
// firestore.rules.next  -  PROPUESTA (PR3). NO DESPLEGADA. NO sustituye a firestore.rules.
// Implementa el diseño PR2 (roles + vinculación de gafas + sesión activa + resultados).
// Solo la carga tests/rules/roles.rules-next.test.mjs en el emulador.
//
// Modelo de identidad:
//   - Gafa Quest   = usuario de Firebase Auth ANÓNIMO (sign_in_provider 'anonymous').
//   - Clínico      = usuario NO anónimo, email verificado y con doc usuarios/{uid} con
//                    rol 'fisioterapeuta' | 'admin' (doc escrito solo por Admin SDK/consola).
//   - Un anónimo NUNCA es clínico, aunque exista usuarios/{uid} (lo bloquea el provider).
//   - PR5c-3b-1: la sesión activa pasa a ciclo de vida persistente por sessionId (registro + buzón + resultado);
//     ver el bloque 'CICLO DE VIDA DE SESION' dentro de match /dispositivos/{deviceUid}.
//
// Límite de accesos a documentos por petición (get/exists/getAfter): 10 en operaciones
// simples y 20 en batch/transacción (cada evaluación sigue limitada a 10); los accesos
// repetidos al mismo documento se cachean. Peor caso aquí (confirmación de vinculación,
// batch de 2 escrituras): usuarios/uid (exists+get, 1 doc), dispositivos/X (getAfter),
// vinculos/C (get + getAfter) => ~5 documentos distintos, muy por debajo del límite.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ identidad
    function signedIn() {
      return request.auth != null;
    }

    function esGafa() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function esClinico() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['fisioterapeuta', 'admin'];
    }

    function esAdmin() {
      return esClinico()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ------------------------------------------------------------------ helpers de datos
    function disp(id) {
      return get(/databases/$(database)/documents/dispositivos/$(id)).data;
    }

    function dispDespues(id) {
      return getAfter(/databases/$(database)/documents/dispositivos/$(id)).data;
    }

    function vinc(codigo) {
      return get(/databases/$(database)/documents/vinculos/$(codigo)).data;
    }

    function vincDespues(codigo) {
      return getAfter(/databases/$(database)/documents/vinculos/$(codigo)).data;
    }

    // Alfabeto de 31 símbolos (sin 0, O, 1, I, L) y longitud 8.
    function codigoValido(c) {
      return c is string && c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{8}$');
    }

    // Identificadores opacos (sessionId, patientId).
    function idOpaco(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function aliasDispositivoOk(d) {
      return !('alias' in d)
        || (d.alias is string && d.alias.matches('^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ _.-]{1,30}$'));
    }

    function strOpt(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function intOpt(d, k, lo, hi) {
      return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    function numOpt(d, k, lo, hi) {
      return !(k in d) || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    // ------------------------------------------------------------------ usuarios
    // Roles: SOLO Admin SDK / consola. Ningún cliente escribe, ni siquiera su propio doc.
    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------ vinculos
    // id = código de 8 símbolos que la gafa muestra y el clínico introduce.
    match /vinculos/{codigo} {
      allow get: if esClinico();
      allow list: if false;

      // La gafa crea su solicitud pendiente; debe ir en batch con dispositivos/{uid}.codigoActual.
      allow create: if esGafa()
        && codigoValido(codigo)
        && request.resource.data.keys().hasOnly(['deviceUid', 'estado', 'usado', 'creadoEn', 'expira'])
        && request.resource.data.keys().hasAll(['deviceUid', 'estado', 'usado', 'creadoEn', 'expira'])
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.usado == false
        && request.resource.data.creadoEn == request.time
        && request.resource.data.expira is timestamp
        && request.resource.data.expira > request.time
        && request.resource.data.expira <= request.time + duration.value(10, 'm')
        && dispDespues(request.auth.uid).codigoActual == codigo
        && dispDespues(request.auth.uid).estado == 'sin_vincular';

      // Confirmación por un clínico (batch con dispositivos/{deviceUid}).
      allow update: if esClinico()
        && resource.data.estado == 'pendiente'
        && resource.data.usado == false
        && request.time < resource.data.expira
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'usado', 'confirmadoPor', 'confirmadoEn'])
        && request.resource.data.estado == 'vinculado'
        && request.resource.data.usado == true
        && request.resource.data.confirmadoPor == request.auth.uid
        && request.resource.data.confirmadoEn == request.time
        && dispDespues(resource.data.deviceUid).ownerUid == request.auth.uid
        && dispDespues(resource.data.deviceUid).estado == 'vinculado'
        && dispDespues(resource.data.deviceUid).codigoActual == codigo;

      // La gafa cancela su propia solicitud mientras siga pendiente.
      allow delete: if esGafa()
        && resource.data.deviceUid == request.auth.uid
        && resource.data.estado == 'pendiente';
    }

    // ------------------------------------------------------------------ dispositivos
    function dispAliasYClaves(n, o) {
      return n.diff(o).affectedKeys().hasOnly(['ownerUid', 'estado', 'vinculadoEn', 'alias']);
    }

    // Rama 1: la gafa solo rota su código mientras está sin vincular.
    function gafaCambiaCodigo(deviceUid) {
      return esGafa()
        && request.auth.uid == deviceUid
        && resource.data.estado == 'sin_vincular'
        && request.resource.data.estado == 'sin_vincular'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codigoActual'])
        && codigoValido(request.resource.data.codigoActual);
    }

    // Rama 2: un clínico vincula (sin_vincular -> vinculado), coherente con el vínculo confirmado en el mismo batch.
    function clinicoVincula(deviceUid) {
      return esClinico()
        && resource.data.estado == 'sin_vincular'
        && request.resource.data.estado == 'vinculado'
        && dispAliasYClaves(request.resource.data, resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.vinculadoEn == request.time
        && aliasDispositivoOk(request.resource.data)
        && vinc(resource.data.codigoActual).estado == 'pendiente'
        && vinc(resource.data.codigoActual).deviceUid == deviceUid
        && vincDespues(resource.data.codigoActual).estado == 'vinculado'
        && vincDespues(resource.data.codigoActual).usado == true
        && vincDespues(resource.data.codigoActual).confirmadoPor == request.auth.uid;
    }

    // Rama 3: revoca el propietario o un admin (vinculado -> revocado, terminal).
    function clinicoRevoca() {
      return esClinico()
        && resource.data.estado == 'vinculado'
        && request.resource.data.estado == 'revocado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revocadoEn'])
        && request.resource.data.revocadoEn == request.time
        && (resource.data.ownerUid == request.auth.uid || esAdmin());
    }

    // Rama 4: el propietario (o un admin, igual que en la revocación) renombra la gafa. Solo 'alias',
    // solo mientras está vinculada (revocado es terminal e inmutable). Alias obligatorio y válido (no se puede borrar).
    function clinicoEditaAlias() {
      return esClinico()
        && resource.data.estado == 'vinculado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias'])
        && 'alias' in request.resource.data
        && aliasDispositivoOk(request.resource.data)
        && (resource.data.ownerUid == request.auth.uid || esAdmin());
    }

    match /dispositivos/{deviceUid} {
      allow get: if (esGafa() && request.auth.uid == deviceUid) || esClinico();
      // Un clínico solo lista SUS dispositivos (la query debe filtrar ownerUid == uid).
      allow list: if esClinico() && resource.data.ownerUid == request.auth.uid;

      allow create: if esGafa()
        && request.auth.uid == deviceUid
        && request.resource.data.keys().hasOnly(['estado', 'codigoActual', 'creadoEn'])
        && request.resource.data.keys().hasAll(['estado', 'codigoActual', 'creadoEn'])
        && request.resource.data.estado == 'sin_vincular'
        && codigoValido(request.resource.data.codigoActual)
        && request.resource.data.creadoEn == request.time;

      allow update: if gafaCambiaCodigo(deviceUid)
        || clinicoVincula(deviceUid)
        || clinicoRevoca()
        || clinicoEditaAlias();

      // Solo la gafa y solo si nunca fue vinculada/revocada (revocado es terminal y no se borra desde cliente).
      allow delete: if esGafa()
        && request.auth.uid == deviceUid
        && resource.data.estado == 'sin_vincular';

      // ================================================================ CICLO DE VIDA DE SESION (PR5c-3b-1)
      // Tres documentos, cada uno con una unica responsabilidad:
      //   dispositivos/{uid}/sesiones_registro/{sid}  FUENTE DE VERDAD del ciclo de vida (config inmutable + estado + trazas).
      //   dispositivos/{uid}/sesion_activa/current    BUZON/PUNTERO de la Quest {sessionId, publicadaEn, venceEn}. Sin config.
      //   sesiones/{sid}                              RESULTADO clinico (create-only, id == sessionId).
      // Estados del registro: pending, running, cancel_requested, completed, interrupted, cancelled, vencida.
      //   - 'vencida' es DERIVADA (pending con now >= venceEn). La Quest NUNCA escribe 'vencida'; solo el propietario
      //     deja la traza (al reemplazarla en el batch de publicacion o a mano). Una pending vencida no se puede INICIAR,
      //     pero una sesion YA iniciada puede terminar aunque venceEn haya pasado.
      //   - Nadie borra registro ni buzon. Las trazas (cancelacion, cierre forzado, resultado tardio) se escriben una vez
      //     y no se modifican (los update son hasOnly y exigen un estado previo que ya no se repite).
      // Plazos: iniciar < venceEn (el cliente usa 20 min; tope 1 h aqui); cierre normal hasta iniciadaEn+duration+30 min;
      //   resultado tardio (tardio == true) hasta iniciadaEn+duration+24 h; cierre forzado por el propietario tras
      //   duration+30 min (running) o 2 min (cancel_requested). Pasado el plazo NO se amplian permisos de escritura:
      //   la recuperacion excepcional es un procedimiento administrativo fuera de las reglas (ver documento de diseño).
      // Sin backend: ninguna regla se ejecuta sola; los plazos se aplican cuando alguien escribe (request.time = servidor).
      // Limite de accesos (10 por evaluacion, 20 por batch; los repetidos al mismo doc se cachean). Distintos por operacion:
      //   publicar (3 escrituras) 7; iniciar 2; cancelar/solicitar/forzar 2-3; cierre+resultado 4 por escritura.
      function propietario() {
        return esClinico() && disp(deviceUid).ownerUid == request.auth.uid;
      }
      function propietarioVinculado() {
        return propietario() && disp(deviceUid).estado == 'vinculado';
      }
      // Quest vinculada y propietaria de ESTE path (la Quest solo calcula rutas bajo su propio uid).
      function esQ() {
        return esGafa() && request.auth.uid == deviceUid && disp(deviceUid).estado == 'vinculado';
      }
      function regRuta(sid) {
        return /databases/$(database)/documents/dispositivos/$(deviceUid)/sesiones_registro/$(sid);
      }
      function curRuta() {
        return /databases/$(database)/documents/dispositivos/$(deviceUid)/sesion_activa/current;
      }
      function resRuta(sid) {
        return /databases/$(database)/documents/sesiones/$(sid);
      }
      function sidOk(v) { return v is string && v.matches('^[A-Za-z0-9_-]{22}$'); }
      function esTerminal(s) { return s in ['completed', 'interrupted', 'cancelled', 'vencida']; }

      // ---------------------------------------------------------------- sesion_activa/current = BUZON (puntero)
      match /sesion_activa/{docId} {
        function punteroOk(d) {
          return d.keys().hasOnly(['sessionId', 'publicadaEn', 'venceEn'])
            && d.keys().hasAll(['sessionId', 'publicadaEn', 'venceEn'])
            && sidOk(d.sessionId)
            && d.publicadaEn == request.time
            && getAfter(regRuta(d.sessionId)).data.status == 'pending'
            && getAfter(regRuta(d.sessionId)).data.publicadaEn == d.publicadaEn
            && getAfter(regRuta(d.sessionId)).data.venceEn == d.venceEn;
        }
        // La sesion anterior (apuntada por el buzon) esta terminal o es una pending vencida que este mismo
        // batch pasa a 'vencida' (D11: nunca se pisa una sesion viva).
        function anteriorLibre(sidViejo) {
          return esTerminal(getAfter(regRuta(sidViejo)).data.status)
            && (esTerminal(get(regRuta(sidViejo)).data.status)
                || (get(regRuta(sidViejo)).data.status == 'pending' && request.time >= get(regRuta(sidViejo)).data.venceEn));
        }
        // Lectura: la Quest vinculada propietaria del path y el clinico propietario. Nunca list.
        // La lectura NO se deniega por vencimiento (un 403 por vencida se confundiria con el de revocacion).
        allow get: if docId == 'current' && (esQ() || propietario());
        allow list: if false;
        allow create: if docId == 'current' && propietarioVinculado() && punteroOk(request.resource.data);
        allow update: if docId == 'current' && propietarioVinculado() && punteroOk(request.resource.data)
          && anteriorLibre(resource.data.sessionId);
        allow delete: if false;
      }

      // ---------------------------------------------------------------- sesiones_registro/{sessionId}
      match /sesiones_registro/{sid} {
        // Alta: el registro nace 'pending' y solo si el buzon apunta a el EN EL MISMO COMMIT (publicacion atomica).
        function regNuevoOk(d) {
          return d.keys().hasOnly(['sessionId', 'patientId', 'patientAlias', 'gameId', 'duration', 'difficulty',
                                   'therapySide', 'sessionType', 'deviceUid', 'ownerUid', 'publicadaEn', 'venceEn', 'status'])
            && d.keys().hasAll(['sessionId', 'patientId', 'patientAlias', 'gameId', 'duration', 'difficulty',
                                'therapySide', 'sessionType', 'deviceUid', 'ownerUid', 'publicadaEn', 'venceEn', 'status'])
            && sidOk(sid) && d.sessionId == sid
            && pidOk(d.patientId) && aliasPOk(d.patientAlias)
            && d.gameId in ['gems', 'vault_escape', 'urban_attention_quest', 'luggage_handler']
            // duration = duracion CONFIGURADA en segundos (inmutable). No es el tiempo realmente jugado (ese va en el resultado).
            && d.duration is int && d.duration >= 1 && d.duration <= 7200
            && d.difficulty is string && d.difficulty.size() >= 1 && d.difficulty.size() <= 20
            && d.therapySide is string && d.therapySide.size() >= 1 && d.therapySide.size() <= 20
            && d.sessionType is string && d.sessionType.size() >= 1 && d.sessionType.size() <= 30
            && d.deviceUid == deviceUid && d.ownerUid == request.auth.uid
            && d.status == 'pending'
            && d.publicadaEn == request.time
            && d.venceEn is timestamp && d.venceEn > request.time
            && d.venceEn <= request.time + duration.value(1, 'h')
            && getAfter(curRuta()).data.sessionId == sid;
        }
        function dif() { return request.resource.data.diff(resource.data).affectedKeys(); }
        function nSt() { return request.resource.data.status; }

        allow get: if esQ() || propietario();
        allow list: if propietario();
        allow create: if propietarioVinculado() && regNuevoOk(request.resource.data);
        allow delete: if false;

        allow update: if
          // Quest: pending -> running (solo si es la sesion vigente del buzon y no ha vencido)
          (esQ() && resource.data.status == 'pending' && nSt() == 'running'
              && request.time < resource.data.venceEn
              && dif().hasOnly(['status', 'iniciadaEn']) && request.resource.data.iniciadaEn == request.time
              && get(curRuta()).data.sessionId == sid)
          // propietario: marca como 'vencida' una pending caducada (traza perezosa; la Quest no la escribe)
          || (propietario() && resource.data.status == 'pending' && nSt() == 'vencida'
              && request.time >= resource.data.venceEn
              && dif().hasOnly(['status', 'finalizadaEn', 'motivo'])
              && request.resource.data.motivo == 'vencida' && request.resource.data.finalizadaEn == request.time)
          // propietario: cancela una pending
          || (propietario() && resource.data.status == 'pending' && nSt() == 'cancelled'
              && dif().hasOnly(['status', 'finalizadaEn', 'motivo', 'cierrePor'])
              && request.resource.data.motivo == 'cancelada_por_web' && request.resource.data.cierrePor == request.auth.uid
              && request.resource.data.finalizadaEn == request.time)
          // propietario: solicita cancelar una running
          || (propietario() && resource.data.status == 'running' && nSt() == 'cancel_requested'
              && dif().hasOnly(['status', 'cancelSolicitadaEn', 'cancelSolicitadaPor'])
              && request.resource.data.cancelSolicitadaEn == request.time
              && request.resource.data.cancelSolicitadaPor == request.auth.uid)
          // Quest: cierre (normal o tardio dentro de 24 h) con resultado atomico (existsAfter) cuando 'resultadoEn' esta
          || (esQ() && resource.data.status in ['running', 'cancel_requested'] && nSt() in ['completed', 'interrupted']
              && dif().hasOnly(['status', 'finalizadaEn', 'motivo', 'resultadoEn', 'tardio'])
              && request.resource.data.finalizadaEn == request.time
              && request.time < resource.data.iniciadaEn + duration.value(resource.data.duration + 86400, 's')
              && request.resource.data.tardio == (request.time > resource.data.iniciadaEn + duration.value(resource.data.duration + 1800, 's'))
              && (nSt() == 'completed'
                    ? (!('motivo' in request.resource.data) && request.resource.data.resultadoEn == request.time)
                    : request.resource.data.motivo in ['cancelada_por_web', 'abandono', 'reinicio', 'error'])
              && (('resultadoEn' in request.resource.data) == existsAfter(resRuta(sid)))
              && (!('resultadoEn' in request.resource.data) || request.resource.data.resultadoEn == request.time))
          // propietario: cierre forzado (D10) con motivo; la traza vive en el propio registro (inmutable, no borrable)
          || (propietario() && nSt() == 'interrupted'
              && dif().hasOnly(['status', 'finalizadaEn', 'motivo', 'cierrePor', 'forzadoPor', 'forzadoEn', 'forzadoMotivo'])
              && request.resource.data.motivo == 'sin_respuesta'
              && request.resource.data.finalizadaEn == request.time && request.resource.data.forzadoEn == request.time
              && request.resource.data.cierrePor == request.auth.uid && request.resource.data.forzadoPor == request.auth.uid
              && request.resource.data.forzadoMotivo is string
              && request.resource.data.forzadoMotivo.size() >= 5 && request.resource.data.forzadoMotivo.size() <= 200
              && ((resource.data.status == 'running'
                     && request.time > resource.data.iniciadaEn + duration.value(resource.data.duration + 1800, 's'))
                  || (resource.data.status == 'cancel_requested'
                     && request.time > resource.data.cancelSolicitadaEn + duration.value(2, 'm'))))
          // Quest: resultado TARDIO sobre un registro ya cerrado a la fuerza (sin_respuesta). No cambia status ni la traza
          // forzada; una sola vez; independiente de 'current' (que puede apuntar ya a otra sesion).
          || (esQ() && resource.data.status == 'interrupted' && resource.data.motivo == 'sin_respuesta'
              && !('resultadoEn' in resource.data)
              && dif().hasOnly(['resultadoEn', 'tardio'])
              && request.resource.data.resultadoEn == request.time && request.resource.data.tardio == true
              && request.time < resource.data.iniciadaEn + duration.value(resource.data.duration + 86400, 's')
              && existsAfter(resRuta(sid)));
      }
    }

    // ------------------------------------------------------------------ sesiones (resultados)
    function clavesComunesResultado() {
      return ['patientId', 'sessionId', 'deviceUid', 'gameId', 'game', 'date', 'duration', 'score',
              'side', 'difficulty', 'sessionType', 'fromVR', 'notes', 'createdAt', 'status', 'durationUnit', 'patientAlias'];
    }

    function clavesGems() {
      return ['accuracy', 'gemsNormal', 'gemsGolden', 'gemsGreen', 'gemsPurple', 'gemsRed', 'gemsRedAvoided',
              'totalGems', 'avgTimePerGem', 'totalMovements', 'movementsSummary', 'zonesWorked'];
    }

    function clavesVault() {
      return ['completion_percentage', 'panels_collected', 'total_panels', 'laser_hits', 'avg_time_per_panel',
              'vertical_range_meters', 'crosses_midline', 'motor_control_score', 'planning_score',
              'spatial_awareness_score'];
    }

    function clavesCity() {
      return ['accuracy', 'completion_percentage', 'targets_collected', 'total_targets', 'sequence_errors',
              'left_side_targets', 'right_side_targets', 'asymmetry_percentage', 'neglect_score',
              'avg_reaction_time', 'cervical_rom_left', 'cervical_rom_right', 'cervical_rom_extension',
              'cervical_rom_flexion', 'cervical_rom_total', 'spatial_awareness', 'orientation',
              'processing_speed', 'cervical_mobility', 'visual_search_efficiency'];
    }

    function clavesLuggage() {
      return ['accuracy_percentage', 'luggage_placed', 'luggage_dropped', 'luggage_wrong', 'max_combo',
              'total_weight_moved', 'max_weight_lifted', 'time_under_load', 'trunk_rotations_left',
              'trunk_rotations_right', 'trunk_asymmetry', 'strength_score', 'endurance_score',
              'trunk_mobility_score', 'coordination_score'];
    }

    // Validación por juego. Para respetar el límite de 1000 expresiones por evaluación se usan
    // comparaciones directas (d.campo >= lo && d.campo <= hi) y campos OBLIGATORIOS (hasAll):
    // un tipo incorrecto (string, bool, null...) provoca error de evaluación => denegado.
    // Consecuencia documentada: no se distingue int de float en los campos numéricos.
    function gemsOk(d) {
      return d.keys().hasAll(clavesGems())
        && d.accuracy >= 0 && d.accuracy <= 100
        && d.gemsNormal >= 0 && d.gemsNormal <= 100000 && d.gemsGolden >= 0 && d.gemsGolden <= 100000
        && d.gemsGreen >= 0 && d.gemsGreen <= 100000 && d.gemsPurple >= 0 && d.gemsPurple <= 100000
        && d.gemsRed >= 0 && d.gemsRed <= 100000 && d.gemsRedAvoided >= 0 && d.gemsRedAvoided <= 100000
        && d.totalGems >= 0 && d.totalGems <= 100000 && d.avgTimePerGem >= 0 && d.avgTimePerGem <= 3600
        && d.totalMovements >= 0 && d.totalMovements <= 100000
        // Los elementos de la lista no se pueden validar en reglas (sin bucles): solo tipo y nº máximo.
        && d.movementsSummary is list && d.movementsSummary.size() <= 50
        && d.zonesWorked is map && d.zonesWorked.keys().hasOnly(['Alto', 'Medio', 'Lateral', 'Bajo'])
        && d.zonesWorked.Alto >= 0 && d.zonesWorked.Alto <= 100000 && d.zonesWorked.Medio >= 0 && d.zonesWorked.Medio <= 100000
        && d.zonesWorked.Lateral >= 0 && d.zonesWorked.Lateral <= 100000 && d.zonesWorked.Bajo >= 0 && d.zonesWorked.Bajo <= 100000;
    }

    function vaultOk(d) {
      return d.keys().hasAll(clavesVault())
        && d.completion_percentage >= 0 && d.completion_percentage <= 100
        && d.panels_collected >= 0 && d.panels_collected <= 10000 && d.total_panels >= 0 && d.total_panels <= 10000
        && d.laser_hits >= 0 && d.laser_hits <= 100000 && d.avg_time_per_panel >= 0 && d.avg_time_per_panel <= 3600
        && d.vertical_range_meters >= 0 && d.vertical_range_meters <= 10
        && d.crosses_midline >= 0 && d.crosses_midline <= 100000
        && d.motor_control_score >= 0 && d.motor_control_score <= 100
        && d.planning_score >= 0 && d.planning_score <= 100
        && d.spatial_awareness_score >= 0 && d.spatial_awareness_score <= 100;
    }

    function cityOk(d) {
      return d.keys().hasAll(clavesCity())
        && d.accuracy >= 0 && d.accuracy <= 100 && d.completion_percentage >= 0 && d.completion_percentage <= 100
        && d.targets_collected >= 0 && d.targets_collected <= 10000 && d.total_targets >= 0 && d.total_targets <= 10000
        && d.sequence_errors >= 0 && d.sequence_errors <= 100000
        && d.left_side_targets >= 0 && d.left_side_targets <= 10000 && d.right_side_targets >= 0 && d.right_side_targets <= 10000
        && d.asymmetry_percentage >= 0 && d.asymmetry_percentage <= 100 && d.neglect_score >= 0 && d.neglect_score <= 100
        && d.avg_reaction_time >= 0 && d.avg_reaction_time <= 3600
        && d.cervical_rom_left >= -360 && d.cervical_rom_left <= 360 && d.cervical_rom_right >= -360 && d.cervical_rom_right <= 360
        && d.cervical_rom_extension >= -360 && d.cervical_rom_extension <= 360
        && d.cervical_rom_flexion >= -360 && d.cervical_rom_flexion <= 360
        && d.cervical_rom_total >= -1440 && d.cervical_rom_total <= 1440
        && d.spatial_awareness >= 0 && d.spatial_awareness <= 100 && d.orientation >= 0 && d.orientation <= 100
        && d.processing_speed >= 0 && d.processing_speed <= 100 && d.cervical_mobility >= 0 && d.cervical_mobility <= 100
        && d.visual_search_efficiency >= 0 && d.visual_search_efficiency <= 100;
    }

    function luggageOk(d) {
      return d.keys().hasAll(clavesLuggage())
        && d.accuracy_percentage >= 0 && d.accuracy_percentage <= 100
        && d.luggage_placed >= 0 && d.luggage_placed <= 10000 && d.luggage_dropped >= 0 && d.luggage_dropped <= 10000
        && d.luggage_wrong >= 0 && d.luggage_wrong <= 10000 && d.max_combo >= 0 && d.max_combo <= 10000
        && d.total_weight_moved >= 0 && d.total_weight_moved <= 1000000
        && d.max_weight_lifted >= 0 && d.max_weight_lifted <= 1000 && d.time_under_load >= 0 && d.time_under_load <= 86400
        && d.trunk_rotations_left >= 0 && d.trunk_rotations_left <= 100000
        && d.trunk_rotations_right >= 0 && d.trunk_rotations_right <= 100000
        && d.trunk_asymmetry >= 0 && d.trunk_asymmetry <= 100
        && d.strength_score >= 0 && d.strength_score <= 100 && d.endurance_score >= 0 && d.endurance_score <= 100
        && d.trunk_mobility_score >= 0 && d.trunk_mobility_score <= 100
        && d.coordination_score >= 0 && d.coordination_score <= 100;
    }

    function resultadoComunOk(d, sessionIdPath) {
      return d.keys().hasAll(['patientId', 'sessionId', 'deviceUid', 'gameId', 'duration', 'score', 'status', 'durationUnit', 'patientAlias'])
        && idOpaco(d.patientId)
        && idOpaco(d.sessionId)
        && d.sessionId == sessionIdPath
        && d.deviceUid == request.auth.uid
        && d.gameId in ['gems', 'vault_escape', 'urban_attention_quest', 'luggage_handler']
        // duration = tiempo REALMENTE jugado, en segundos (durationUnit). No se compara con la duracion configurada del
        // registro (otro campo, otra semantica). Unidades de las metricas: *_percentage/accuracy/*_score/completion en
        // 0..100; avgTimePerGem, avg_time_per_panel, avg_reaction_time en segundos; vertical_range_meters en metros;
        // cervical_rom_* en grados; time_under_load en segundos; pesos en kg; contadores sin unidad.
        && d.durationUnit == 's'
        && d.status in ['completed', 'interrupted']
        && d.duration is int && d.duration >= 0 && d.duration <= 86400
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && strOpt(d, 'game', 60) && strOpt(d, 'date', 40) && strOpt(d, 'side', 20)
        && strOpt(d, 'difficulty', 30) && strOpt(d, 'sessionType', 30)
        && (!('fromVR' in d) || d.fromVR == true)
        // Texto libre prohibido desde la gafa: notes solo puede ir vacío.
        && (!('notes' in d) || d.notes == '')
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    function resultadoPorJuegoOk(d) {
      return (d.gameId == 'gems' && d.keys().hasOnly(clavesComunesResultado().concat(clavesGems())) && gemsOk(d))
        || (d.gameId == 'vault_escape' && d.keys().hasOnly(clavesComunesResultado().concat(clavesVault())) && vaultOk(d))
        || (d.gameId == 'urban_attention_quest' && d.keys().hasOnly(clavesComunesResultado().concat(clavesCity())) && cityOk(d))
        || (d.gameId == 'luggage_handler' && d.keys().hasOnly(clavesComunesResultado().concat(clavesLuggage())) && luggageOk(d));
    }

    // El resultado se ata al REGISTRO por sessionId (no a 'current'): la Quest solo accede a SU subcoleccion.
    // r = registro ANTES del commit; a = registro DESPUES (mismo batch). El batch debe dejar resultadoEn == request.time.
    //   - ordinario/tardio-en-curso: registro running|cancel_requested -> a.status == d.status (completed|interrupted).
    //   - recuperacion tardia tras cierre forzado: registro interrupted/sin_respuesta, a.tardio == true; el resultado
    //     puede declarar 'completed' o 'interrupted' (lo que la Quest declara); el registro CONSERVA interrupted/sin_respuesta
    //     y la traza forzado*, y solo gana resultadoEn/tardio (una vez).
    // Semantica de las tres magnitudes (sin campos nuevos):
    //   (1) finalizacion REAL declarada por la Quest = sesiones/{sid}.status (completed|interrupted), inmutable (create-only).
    //   (2) recepcion tardia = registro.tardio, calculado contra request.time (> iniciadaEn+duration+30 min).
    //   (3) fecha de sincronizacion = registro.resultadoEn == request.time (servidor).
    //   Cierre normal (no forzado): registro.status == resultado.status. Tras forzado: pueden diferir; manda (1) para la
    //   clinica y el registro conserva la historia administrativa.
    function sesionActivaVigente(d, sid) {
      let r = get(/databases/$(database)/documents/dispositivos/$(request.auth.uid)/sesiones_registro/$(sid)).data;
      let a = getAfter(/databases/$(database)/documents/dispositivos/$(request.auth.uid)/sesiones_registro/$(sid)).data;
      return disp(request.auth.uid).estado == 'vinculado'
        && r.patientId == d.patientId && r.patientAlias == d.patientAlias && r.gameId == d.gameId
        && a.resultadoEn == request.time
        && request.time < r.iniciadaEn + duration.value(r.duration + 86400, 's')
        && ((r.status in ['running', 'cancel_requested'] && a.status == d.status)
            || (r.status == 'interrupted' && r.motivo == 'sin_respuesta' && a.status == 'interrupted' && a.tardio == true));
    }

    match /sesiones/{sessionId} {
      // Create-only desde la gafa: un segundo create con el mismo id se deniega (idempotencia).
      allow create: if esGafa()
        && resultadoComunOk(request.resource.data, sessionId)
        && resultadoPorJuegoOk(request.resource.data)
        && sesionActivaVigente(request.resource.data, sessionId);

      // La gafa lee sus propios resultados solo mientras siga vinculada (una gafa revocada pierde todo acceso a datos).
      allow get: if esClinico()
        || (esGafa() && resource.data.deviceUid == request.auth.uid && disp(request.auth.uid).estado == 'vinculado');
      allow list: if esClinico();

      // El clínico solo edita 'notes' y, opcionalmente, 'updatedAt' (== request.time). Nada más.
      allow update: if esClinico()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt'])
        && strOpt(request.resource.data, 'notes', 2000)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);

      // Los resultados clinicos NO se borran desde el cliente (D7). La supresion RGPD o la rectificacion se hacen con un
      // procedimiento administrativo (Admin SDK) y no por reglas. Dependencia: db.ts deletePatient borra en cascada.
      allow delete: if false;
    }

    // ------------------------------------------------------------------ pacientes
    function pacienteValido(d) {
      return d.keys().hasAll(['name', 'initials', 'age', 'affectedSide', 'lastSession', 'progress',
                              'diagnosis', 'sessions', 'status', 'colorIdx', 'notes'])
        && d.keys().hasOnly(['name', 'initials', 'age', 'affectedSide', 'lastSession', 'progress',
                             'diagnosis', 'sessions', 'status', 'colorIdx', 'notes', 'alias', 'pid', 'aliasNum',
                             'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.initials is string && d.initials.size() <= 4
        && d.age is int && d.age >= 0 && d.age <= 120
        && d.affectedSide in ['Derecho', 'Izquierdo', 'Ambos']
        && d.lastSession is string && d.lastSession.size() <= 40
        && d.progress is number && d.progress >= 0 && d.progress <= 100
        && d.diagnosis is string && d.diagnosis.size() <= 200
        && d.sessions is int && d.sessions >= 0 && d.sessions <= 100000
        && d.status in ['activo', 'inactivo']
        && d.colorIdx is int && d.colorIdx >= 0 && d.colorIdx <= 50
        && d.notes is string && d.notes.size() <= 2000
        // Identidad pseudónima (PR5c-3a). Aquí solo tipo/forma; la inmutabilidad y la coherencia con el
        // contador las imponen create/update de pacientes y el match de config/aliasPacientes.
        // 'alias' admite además el valor LEGADO (texto libre <= 30) mientras no se asigne identidad.
        && strOpt(d, 'alias', 30)
        && (!('pid' in d) || pidOk(d.pid))
        && intOpt(d, 'aliasNum', 1, 999999)
        && (!(('pid' in d) || ('aliasNum' in d)) || d.keys().hasAll(['alias', 'aliasNum', 'pid']))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ------------------------------------------------------------------ identidad de paciente (PR5c-3a)
    // pid   : 22 caracteres base64url (128 bits aleatorios generados en el cliente con WebCrypto). Es lo ÚNICO
    //         (junto al alias) que la Quest recibe del paciente. Las reglas no pueden demostrar que es aleatorio.
    // alias : 'P-' + aliasNum rellenado a 3 dígitos (P-001 ... P-999, P-1000 ... P-999999), único y global.
    // Contador monótono config/aliasPacientes {ultimo, ultimoPacienteId, actualizadoEn}: solo sube +1 y solo en el
    // MISMO commit en que un paciente sin identidad recibe alias/aliasNum/pid. Nunca se borra ni retrocede, así
    // que borrar un paciente NO libera su número (hueco permitido). Probado con string() en el emulador (D5).
    function aliasPOk(v) { return v is string && v.matches('^P-[0-9]{3,6}$'); }
    function pidOk(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{22}$');
    }

    function aliasDeNum(n) {
      return 'P-' + (n < 10 ? '00' + string(n) : (n < 100 ? '0' + string(n) : string(n)));
    }

    function contRuta() {
      return /databases/$(database)/documents/config/aliasPacientes;
    }

    function pacRuta(pacienteId) {
      return /databases/$(database)/documents/pacientes/$(pacienteId);
    }

    function ultimoAntes() {
      return exists(contRuta()) ? get(contRuta()).data.ultimo : 0;
    }

    // Identidad sin cambios (incluye pacientes legados sin pid ni aliasNum, y alias legado intacto).
    function identidadIgual(n, o) {
      return n.get('alias', null) == o.get('alias', null)
        && n.get('pid', null) == o.get('pid', null)
        && n.get('aliasNum', null) == o.get('aliasNum', null);
    }

    // Primera (y única) asignación: el paciente aún no tiene pid ni aliasNum; el contador pasa de N a N+1 en el
    // mismo commit con ultimoPacienteId == este paciente; alias == 'P-' + pad(N+1); aliasNum == N+1.
    function primeraAsignacion(n, o, pacienteId) {
      return !('pid' in o) && !('aliasNum' in o)
        && n.diff(o).affectedKeys().hasOnly(['alias', 'aliasNum', 'pid', 'updatedAt'])
        && n.keys().hasAll(['alias', 'aliasNum', 'pid'])
        && n.aliasNum is int && n.aliasNum >= 1 && n.aliasNum <= 999999
        && n.alias == aliasDeNum(n.aliasNum)
        && ultimoAntes() == n.aliasNum - 1
        && existsAfter(contRuta())
        && getAfter(contRuta()).data.ultimo == n.aliasNum
        && getAfter(contRuta()).data.ultimoPacienteId == pacienteId;
    }

    match /pacientes/{id} {
      allow get, list: if esClinico();
      // Al CREAR no hay identidad: ni alias, ni pid, ni aliasNum (se asignan después, de forma perezosa, por la
      // transacción de app/patientIdentity.ts). Borrar y recrear NO reutiliza nada: el recreado no la tiene.
      allow create: if esClinico()
        && pacienteValido(request.resource.data)
        && !('alias' in request.resource.data) && !('pid' in request.resource.data)
        && !('aliasNum' in request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if esClinico()
        && pacienteValido(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && (identidadIgual(request.resource.data, resource.data)
            || primeraAsignacion(request.resource.data, resource.data, id));
      allow delete: if esClinico();
    }

    // Contador global de alias (sin multi-clínica: ver D1 en el contrato; futuro clinicas/{id}/config/aliasPacientes).
    function contadorForma(d) {
      return d.keys().hasOnly(['ultimo', 'ultimoPacienteId', 'actualizadoEn'])
        && d.keys().hasAll(['ultimo', 'ultimoPacienteId', 'actualizadoEn'])
        && d.ultimo is int && d.ultimo >= 1 && d.ultimo <= 999999
        && idOpaco(d.ultimoPacienteId)
        && d.actualizadoEn == request.time;
    }

    // El paciente apuntado existe, NO tenía identidad antes y la recibe en este commit, coherente con el contador.
    function contadorAsignaPaciente(d) {
      return exists(pacRuta(d.ultimoPacienteId))
        && !('pid' in get(pacRuta(d.ultimoPacienteId)).data)
        && !('aliasNum' in get(pacRuta(d.ultimoPacienteId)).data)
        && getAfter(pacRuta(d.ultimoPacienteId)).data.aliasNum == d.ultimo
        && getAfter(pacRuta(d.ultimoPacienteId)).data.alias == aliasDeNum(d.ultimo);
    }

    match /config/aliasPacientes {
      allow get: if esClinico();
      allow list: if false;
      allow create: if esClinico()
        && contadorForma(request.resource.data)
        && request.resource.data.ultimo == 1
        && contadorAsignaPaciente(request.resource.data);
      allow update: if esClinico()
        && contadorForma(request.resource.data)
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && contadorAsignaPaciente(request.resource.data);
      allow delete: if false;
    }

    // Todo lo demás (incluida sesion_activa en raíz y colecciones sin regla): denegado por defecto.
  }
}
